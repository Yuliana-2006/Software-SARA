@model Software_SARA.Dtos.RecordatorioPedidoDto

@{
    ViewData["Title"] = "Confirmar Recordatorio de Pedido";
}

<div class="form-container-sara">
    <div class="form-header-banner">
        <h2>Confirmar Recordatorio de Pedido</h2>
    </div>

    <div class="form-card-box-center">
        <div class="modal-box-sara">
            <p class="modal-pregunta">¿Desea confirmar el recordatorio del pedido?</p>
            
            <form asp-controller="Recordatorios" asp-action="Confirmar" method="post">
                <input type="hidden" asp-for="IdRecordatorio" />
                
                <div class="form-buttons-footer">
                    <button type="submit" class="btn-sara-action">Confirmar</button>
                    <a asp-controller="Recordatorios" asp-action="Index" class="btn-sara-action btn-cancelar">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .form-container-sara { width: 100%; min-height: calc(100vh - 120px); display: flex; flex-direction: column; align-items: center; padding-top: 15px; box-sizing: border-box; }
    .form-header-banner { width: 100%; padding: 0 40px; margin-bottom: 20px; }
    .form-header-banner h2 { margin: 0; color: #2E4F3E; font-size: 34px; font-weight: 800; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    
    .form-card-box-center { width: 85%; max-width: 800px; height: 380px; background-color: #ECE9DF; border: 6px solid #2E4F3E; border-radius: 30px; display: flex; align-items: center; justify-content: center; box-shadow: 0 5px 15px rgba(0,0,0,0.15); }
    
    .modal-box-sara { width: 80%; height: 260px; background-color: #5B805E; border: 4px solid #2E4F3E; border-radius: 25px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px; }
    
    .modal-pregunta { color: white; font-size: 24px; font-weight: 800; text-align: center; margin-bottom: 30px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    
    .form-buttons-footer { display: flex; justify-content: center; gap: 30px; width: 100%; }
    
    .btn-sara-action { width: 140px; height: 42px; background-color: #ECE9DF; border: 4px solid #2E4F3E; border-radius: 20px; color: #2E4F3E; font-size: 15px; font-weight: 800; cursor: pointer; text-decoration: none; display: flex; align-items: center; justify-content: center; transition: 0.2s; }
    .btn-sara-action:hover { background-color: #DCD9CF; transform: scale(1.03); }
    .btn-cancelar { background-color: #DCD9CF; }
</style>