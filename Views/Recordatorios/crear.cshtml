@model Software_SARA.Dtos.RecordatorioPedidoDto

@{
    ViewData["Title"] = "Agregar Recordatorio de Pedido";
}

<div class="form-container-sara">
    <div class="form-header-banner">
        <h2>Agregar Recordatorio de Pedido</h2>
    </div>

    <div class="form-card-box">
        <div asp-validation-summary="All" class="validation-box"></div>

        <form asp-controller="Recordatorios" asp-action="Crear" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Estado" value="0" />

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="Proveedor">Proveedor</label>
                    <select asp-for="Proveedor" class="sara-input" asp-items="ViewBag.Proveedores">
                        <option value="">Seleccione un proveedor</option>
                    </select>
                    <span asp-validation-for="Proveedor" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="FechaEntrega">Fecha de entrega</label>
                    <input asp-for="FechaEntrega" type="date" class="sara-input" />
                    <span asp-validation-for="FechaEntrega" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="IdRecordatorio">Id Recordatorio</label>
                    <input asp-for="IdRecordatorio" class="sara-input" readonly style="background-color: #4A6E4D; opacity: 0.85; cursor: not-allowed;" />
                    <span asp-validation-for="IdRecordatorio" class="text-danger"></span>
                </div>

                <!-- Campo de Estado informativo de solo lectura -->
                <div class="form-group">
                    <label>Estado</label>
                    <input type="text" value="Pendiente" class="sara-input" readonly style="background-color: #4A6E4D; opacity: 0.85; cursor: not-allowed;" />
                </div>
            </div>

            <div class="form-buttons-footer">
                <button type="submit" class="btn-sara-action">Registrar</button>
                <a asp-controller="Recordatorios" asp-action="Index" class="btn-sara-action btn-cancelar">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<style>
    .form-container-sara { width: 100%; min-height: calc(100vh - 120px); display: flex; flex-direction: column; align-items: center; padding-top: 15px; box-sizing: border-box; }
    .form-header-banner { width: 100%; padding: 0 40px; margin-bottom: 20px; }
    .form-header-banner h2 { margin: 0; color: #2E4F3E; font-size: 34px; font-weight: 800; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    .form-card-box { width: 85%; max-width: 800px; background-color: #ECE9DF; border: 6px solid #2E4F3E; border-radius: 30px; padding: 40px; box-shadow: 0 5px 15px rgba(0,0,0,0.15); }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 40px; }
    .form-group label { display: block; color: #2E4F3E; font-weight: 800; font-size: 16px; margin-bottom: 8px; }
    .sara-input { width: 100%; height: 45px; background-color: #5B805E; border: 4px solid #2E4F3E; border-radius: 25px; padding: 0 18px; color: white; font-weight: 700; font-size: 16px; box-sizing: border-box; outline: none; }
    .sara-input option { background-color: #5B805E; color: white; }
    .sara-input::placeholder { color: #DCD9CF; }
    .form-buttons-footer { display: flex; justify-content: center; gap: 25px; }
    .btn-sara-action { width: 150px; height: 45px; background-color: #5B805E; border: 5px solid #2E4F3E; border-radius: 25px; color: #ECE9DF; font-size: 16px; font-weight: 800; cursor: pointer; text-decoration: none; display: flex; align-items: center; justify-content: center; transition: 0.2s; }
    .btn-sara-action:hover { background-color: #4A6E4D; color: white; transform: scale(1.03); }
    .btn-cancelar { background-color: #DCD9CF; color: #2E4F3E; }
    .text-danger { color: #A93226; font-size: 15px; font-weight: 800; margin-top: 6px; display: block; }
    .validation-box { color: #A93226; background-color: #FDEDEC; border: 2px solid #A93226; border-radius: 15px; padding: 12px 18px; margin-bottom: 20px; font-weight: 700; }
    .validation-box:empty { display: none; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}