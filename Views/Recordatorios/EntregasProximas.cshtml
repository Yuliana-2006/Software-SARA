@model IEnumerable<Software_SARA.Dtos.RecordatorioPedidoDto>

@{
    ViewData["Title"] = "Entregas Próximas y Alertas";
}

<div class="facturas-container">

    <div class="facturas-header-banner">
        <h2>Entregas Próximas (Alertas)</h2>
        <a asp-controller="Recordatorios" asp-action="Index" class="btn-vencimientos">Volver</a>
    </div>

    <div class="facturas-cards-wrapper">

        @if (Model != null && Model.Any())
        {
            @foreach (var rec in Model)
            {
                <div class="facturas-card" style="border-color: #A93226;">
                    <div class="facturas-icon" style="background-color: #FADBD8; color: #A93226;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>

                    <div class="facturas-name" style="text-align: center; padding: 0 10px;">
                        <h2 style="font-size: 16px; margin-top: 10px;">@rec.Proveedor</h2>
                        <div style="font-size: 14px; font-weight: 700; color: #ECE9DF; margin-top: 6px;">ID: @rec.IdRecordatorio</div>
                        <div style="font-size: 13px; font-weight: 600; color: #ECE9DF; margin-top: 4px;">Entrega: @rec.FechaEntrega.ToString("dd/MM/yyyy")</div>
                        <div style="font-size: 13px; font-weight: 800; color: #FADBD8; margin-top: 6px; background-color: #78281F; padding: 4px; border-radius: 10px;">@rec.Estado</div>
                    </div>

                    <div class="facturas-buttons" style="margin-top: 15px;">
                        <!-- Se agregó asp-route-origen="alertas" para la navegación inteligente -->
                        <a asp-controller="Recordatorios" asp-action="Consultar" asp-route-id="@rec.IdRecordatorio" asp-route-origen="alertas" class="facturas-button">Consultar</a>
                        <a asp-controller="Recordatorios" asp-action="Confirmar" asp-route-id="@rec.IdRecordatorio" class="facturas-button" style="background-color: #A93226; color: white;">Confirmar</a>
                    </div>
                </div>
            }
        }
        else
        {
            <div style="text-align: center; margin-top: 50px; color: #2E4F3E;">
                <h3>No hay entregas próximas que requieran atención en este momento.</h3>
                <p style="font-size: 16px; font-weight: 600;">Las alertas aparecerán automáticamente cuando falten 10, 5, 3 días o el mismo día del vencimiento.</p>
            </div>
        }

    </div>
</div>

<style>
    .facturas-container { width: 100%; min-height: calc(100vh - 120px); display: flex; flex-direction: column; align-items: center; padding-top: 10px; box-sizing: border-box; }
    .facturas-header-banner { width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 0 40px; box-sizing: border-box; margin-bottom: 20px; }
    .facturas-header-banner h2 { margin: 0; color: #2E4F3E; font-size: 36px; font-weight: 800; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    .btn-vencimientos { background-color: #385141; color: #ECE9DF; padding: 10px 22px; border-radius: 25px; font-size: 16px; font-weight: 700; text-decoration: none; box-shadow: 0 4px 8px rgba(0,0,0,0.15); display: flex; align-items: center; justify-content: center; }
    .btn-vencimientos:hover { background-color: #2E4F3E; color: white; }
    .facturas-cards-wrapper { width: 100%; display: flex; justify-content: center; align-items: flex-start; gap: 40px; flex-wrap: wrap; padding-top: 10px; }
    .facturas-card { width: 280px; height: 430px; background-color: #5B805E; border: 7px solid #2E4F3E; border-radius: 35px; display: flex; flex-direction: column; align-items: center; box-shadow: 0 5px 10px rgba(0,0,0,0.18); overflow: hidden; box-sizing: border-box; }
    .facturas-icon { width: 80px; height: 80px; margin-top: 20px; background-color: #ECE9DF; border: 5px solid #2E4F3E; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 35px; }
    .facturas-name h2 { margin: 0; font-size: 18px; color: #ECE9DF; text-align: center; font-weight: 800; }
    .facturas-buttons { display: flex; flex-direction: column; gap: 6px; width: 100%; align-items: center; }
    .facturas-button { width: 140px; height: 32px; border-radius: 20px; border: 5px solid #2E4F3E; background-color: #ECE9DF; color: #355B43; font-size: 14px; font-weight: 800; text-decoration: none; display: flex; align-items: center; justify-content: center; transition: 0.2s; }
    .facturas-button:hover { transform: scale(1.03); }
</style>