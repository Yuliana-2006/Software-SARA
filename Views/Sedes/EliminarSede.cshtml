@model Software_SARA.Dtos.SedeDto

@{
    ViewData["Title"] = "Eliminar Sede";
    bool bloqueada = ViewBag.Bloqueado == true;
}

<div class="eliminar-page">
    @if (ViewData["Mensaje"] != null)
    {
        <div style="color: white; background-color: #8B3A3A; padding: 12px 18px; border-radius: 10px; margin: 0 auto 15px auto; max-width: 625px; text-align: center; font-weight: 700;">
            @ViewData["Mensaje"]
        </div>
    }

    <!-- ENCABEZADO -->
    <div class="eliminar-header">
        <h1>DESACTIVAR SEDE</h1>
    </div>

    <!-- TARJETA DE CONFIRMACIÓN -->
    <div class="confirmacion-container">
        <div class="confirmacion-card">
            @if (!bloqueada)
            {
                <h2>
                    ¿Desea desactivar
                    <br />
                    la sede
                    <br />
                    seleccionada?
                </h2>
            }
            else
            {
                <h2>
                    No se puede desactivar
                    <br />
                    esta sede porque tiene
                    <br />
                    información asociada
                </h2>
            }

            <div class="confirmacion-buttons">
                @if (!bloqueada)
                {
                    <!-- CONFIRMAR -->
                    <form asp-controller="Sedes"
                          asp-action="EliminarSede"
                          method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="IdSede" />
                        <button type="submit" class="confirmacion-button">
                            Confirmar
                        </button>
                    </form>
                }

                <!-- CANCELAR / VOLVER -->
                <a asp-controller="Sedes"
                   asp-action="RegistrarSede"
                   class="confirmacion-button">
                    @(bloqueada ? "Volver" : "Cancelar")
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .eliminar-page {
        width: 100%;
        min-height: 100vh;
        background-color: #ECE9DF;
    }

    .eliminar-header {
        width: 100%;
        height: 90px;
        background-color: #3C694F;
        display: flex;
        align-items: center;
        padding-left: 50px;
        box-sizing: border-box;
    }

        .eliminar-header h1 {
            margin: 0;
            color: white;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 42px;
            font-weight: 800;
        }

    .confirmacion-container {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding-top: 88px;
        box-sizing: border-box;
    }

    .confirmacion-card {
        width: 625px;
        min-height: 335px;
        background-color: #5E8562;
        border: 5px solid #2E4F3E;
        border-radius: 32px;
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.20);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 45px 35px;
        box-sizing: border-box;
    }

        .confirmacion-card h2 {
            margin: 0;
            color: white;
            text-align: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 31px;
            line-height: 1.35;
            font-weight: 800;
        }

    .confirmacion-buttons {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
        margin-top: 42px;
    }

        .confirmacion-buttons form {
            margin: 0;
        }

    .confirmacion-button {
        width: 170px;
        height: 56px;
        border-radius: 25px;
        border: 2px solid #2E4F3E;
        background-color: #ECE9DF;
        color: #293F32;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 19px;
        font-weight: 800;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        cursor: pointer;
    }

        .confirmacion-button:hover {
            background-color: #DCD9CF;
            color: #293F32;
        }

    @@media (max-width: 700px) {
        .eliminar-header {
            padding-left: 25px;
        }

            .eliminar-header h1 {
                font-size: 32px;
            }

        .confirmacion-card {
            width: calc(100% - 30px);
        }
    }
</style>