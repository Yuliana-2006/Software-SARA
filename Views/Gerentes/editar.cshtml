@model Software_SARA.Dtos.GerenteDto

@{
    ViewData["Title"] = "Editar Gerente - SARA";
}

<style>
    body {
        background-color: #E6E4DC;
        margin: 0;
        padding: 0;
    }

    .header-banner {
        background-color: #385E42;
        color: white;
        padding: 15px 40px;
        margin-bottom: 30px;
    }

    .header-banner h1 {
        font-size: 2.2rem;
        font-weight: 900;
        margin: 0;
    }

    .form-container {
        display: flex;
        justify-content: center;
        padding: 20px 15px;
    }

    .card-form-sara {
        width: 100%;
        max-width: 550px;
        background-color: #2D4A36;
        border-radius: 25px;
        padding: 30px 25px;
        box-shadow: 0 8px 18px rgba(0,0,0,0.2);
    }

    .form-group-sara {
        margin-bottom: 15px;
    }

    .form-label-sara {
        color: #E6E4DC;
        font-weight: 700;
        font-size: 0.95rem;
        margin-bottom: 5px;
        display: block;
    }

    .form-control-sara {
        width: 100%;
        background-color: #587B58;
        border: 2px solid #385E42;
        border-radius: 12px;
        padding: 10px 15px;
        color: white;
        font-weight: 600;
        font-size: 1rem;
        outline: none;
    }

    .form-control-sara:focus {
        background-color: #496849;
        border-color: #E6E4DC;
        box-shadow: none;
        color: white;
    }

    /* Recuadro superior simple */
    .error-resumen {
        background-color: #ffe6e6;
        color: #b30000;
        border: 1px solid #ffcccc;
        border-radius: 12px;
        padding: 12px 15px;
        font-weight: 700;
        font-size: 0.95rem;
        margin-bottom: 20px;
        text-align: center;
    }

    /* Letra de validación por campo en #ffcccc */
    .text-danger-sara,
    .field-validation-error {
        color: #ffcccc !important;
        font-size: 0.9rem !important;
        font-weight: 800 !important;
        margin-top: 6px !important;
        display: block !important;
    }

    .field-validation-valid {
        display: none !important;
    }

    .btn-container-actions {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 30px;
    }

    .btn-pill-guardar {
        background-color: #E6E4DC;
        color: #2D4A36;
        border: 2px solid #2D4A36;
        border-radius: 20px;
        padding: 8px 30px;
        font-weight: 800;
        font-size: 1.05rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-pill-guardar:hover {
        background-color: #2D4A36;
        color: white;
        border-color: #E6E4DC;
    }

    .btn-pill-cancelar {
        background-color: #E6E4DC;
        color: #2D4A36;
        border: 2px solid #2D4A36;
        border-radius: 20px;
        padding: 8px 30px;
        font-weight: 800;
        font-size: 1.05rem;
        text-decoration: none;
        display: inline-block;
        transition: all 0.2s ease;
    }

    .btn-pill-cancelar:hover {
        background-color: #2D4A36;
        color: white;
        border-color: #E6E4DC;
    }
</style>

<div class="header-banner">
    <h1>Editar Gerente</h1>
</div>

<div class="form-container">
    <div class="card-form-sara">
        <form asp-controller="Gerentes" asp-action="Editar" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="error-resumen">
                    Revisa los datos ingresados.
                </div>
            }

            <div class="form-group-sara">
                <label class="form-label-sara">Nombres</label>
                <input asp-for="Nombres" class="form-control-sara" />
                <span asp-validation-for="Nombres" class="text-danger-sara"></span>
            </div>

            <div class="form-group-sara">
                <label class="form-label-sara">Apellidos</label>
                <input asp-for="Apellidos" class="form-control-sara" />
                <span asp-validation-for="Apellidos" class="text-danger-sara"></span>
            </div>

            <div class="row">
                <div class="col-md-4 form-group-sara">
                    <label class="form-label-sara">Tipo Doc.</label>
                    <select asp-for="TipoDocumento" class="form-control-sara">
                        <option value="CC">CC</option>
                        <option value="CE">CE</option>
                        <option value="PASAPORTE">Pasaporte</option>
                    </select>
                </div>
                <div class="col-md-8 form-group-sara">
                    <label class="form-label-sara">Número de Documento (5 a 10 dígitos)</label>
                    <input asp-for="NumeroDocumento"
                           id="inputDocumentoGerenteEditar"
                           type="text"
                           inputmode="numeric"
                           maxlength="10"
                           autocomplete="off"
                           class="form-control-sara" />
                    <span asp-validation-for="NumeroDocumento" class="text-danger-sara"></span>
                </div>
            </div>

            <div class="form-group-sara">
                <label class="form-label-sara">Correo electrónico</label>
                <input asp-for="Correo" type="email" class="form-control-sara" />
                <span asp-validation-for="Correo" class="text-danger-sara"></span>
            </div>

            <div class="form-group-sara">
                <label class="form-label-sara">Teléfono (10 números)</label>
                <input asp-for="Telefono"
                       id="inputTelefonoGerenteEditar"
                       type="text"
                       inputmode="numeric"
                       maxlength="10"
                       autocomplete="off"
                       class="form-control-sara" />
                <span asp-validation-for="Telefono" class="text-danger-sara"></span>
            </div>

            <div class="form-group-sara">
                <label class="form-label-sara">Dirección</label>
                <input asp-for="Direccion" class="form-control-sara" />
                <span asp-validation-for="Direccion" class="text-danger-sara"></span>
            </div>

            <!-- Sede Asignada -->
            <div class="form-group-sara">
                <label class="form-label-sara">Sede Asignada</label>
                <select asp-for="IdSede" class="form-control-sara" asp-items="ViewBag.ListaSedes">
                    <option value="">-- Seleccione una Sede --</option>
                </select>
                <span asp-validation-for="IdSede" class="text-danger-sara"></span>
            </div>

            <div class="form-group-sara">
                <label class="form-label-sara">Fecha de Nacimiento</label>
                <input asp-for="FechaNacimiento" type="date" class="form-control-sara"
                       value="@(Model.FechaNacimiento?.ToString("yyyy-MM-dd"))" />
                <span asp-validation-for="FechaNacimiento" class="text-danger-sara"></span>
            </div>

            <div class="btn-container-actions">
                <button type="submit" class="btn-pill-guardar">Guardar cambios</button>
                <a asp-controller="Gerentes" asp-action="Index" class="btn-pill-cancelar">Cancelar</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            function restringirSoloNumeros(input, maxLen) {
                if (!input) return;

                input.addEventListener('beforeinput', function (e) {
                    if (e.data && /[^0-9]/.test(e.data)) {
                        e.preventDefault();
                    }
                });

                input.addEventListener('input', function () {
                    const limpio = this.value.replace(/[^0-9]/g, '').slice(0, maxLen);
                    if (this.value !== limpio) {
                        this.value = limpio;
                    }
                });
            }

            restringirSoloNumeros(document.getElementById('inputDocumentoGerenteEditar'), 10);
            restringirSoloNumeros(document.getElementById('inputTelefonoGerenteEditar'), 10);
        })();
    </script>
}