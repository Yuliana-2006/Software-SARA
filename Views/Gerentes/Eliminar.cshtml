@model Software_SARA.Controllers.GerenteViewModel

@{
    ViewData["Title"] = "Eliminar Gerente - SARA";
}

<style>
    body {
        background-color: #E6E4DC;
    }

    .banner-titulo {
        background-color: #2D4A36;
        color: white;
        padding: 20px 40px;
        font-size: 2.5rem;
        font-weight: 800;
    }

    .eliminar-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 180px);
        padding: 20px;
    }

    .card-confirmacion {
        width: 100%;
        max-width: 600px;
        background-color: #587B58;
        border: 5px solid #2D4A36;
        border-radius: 35px;
        padding: 50px 30px;
        text-align: center;
        color: white;
        box-shadow: 0 8px 16px rgba(0,0,0,0.2);
    }

    .pregunta-texto {
        font-size: 2.2rem;
        font-weight: 800;
        line-height: 1.3;
        margin-bottom: 40px;
    }

    .btn-pill-confirmar {
        background-color: #E6E4DC;
        color: #2D4A36;
        border: 4px solid #2D4A36;
        border-radius: 30px;
        padding: 10px 35px;
        font-weight: 800;
        font-size: 1.3rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-pill-confirmar:hover {
        background-color: #2D4A36;
        color: white;
    }

    .btn-pill-cancelar {
        background-color: #E6E4DC;
        color: #2D4A36;
        border: 4px solid #2D4A36;
        border-radius: 30px;
        padding: 10px 35px;
        font-weight: 800;
        font-size: 1.3rem;
        text-decoration: none;
        display: inline-block;
        transition: all 0.2s ease;
    }

    .btn-pill-cancelar:hover {
        background-color: #2D4A36;
        color: white;
    }
</style>

<div class="banner-titulo">
    Eliminar Gerente
</div>

<div class="eliminar-container">
    <div class="card-confirmacion">
        <div class="pregunta-texto">
            ¿Desea desactivar al gerente seleccionado?
        </div>

        <form asp-controller="Gerentes" asp-action="EliminarConfirmado" method="post">
            <input type="hidden" asp-for="Id" />
            
            <div class="d-flex justify-content-center gap-4">
                <button type="submit" class="btn-pill-confirmar">
                    Confirmar
                </button>
                <a asp-controller="Gerentes" asp-action="Index" class="btn-pill-cancelar">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>