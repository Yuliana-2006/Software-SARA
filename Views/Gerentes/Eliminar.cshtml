@model Software_SARA.Dtos.GerenteDto

@{
    ViewData["Title"] = "Eliminar Gerente - SARA";
}

<style>
    body {
        background-color: #E6E4DC;
        margin: 0;
        padding: 0;
    }

    .header-banner {
        background-color: #385E42;
        color: white;
        padding: 15px 40px;
        margin-bottom: 50px;
    }

    .header-banner h1 {
        font-size: 2.2rem;
        font-weight: 900;
        margin: 0;
    }

    .confirm-container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .card-confirm {
        width: 100%;
        max-width: 500px;
        background-color: #587B58;
        border: 4px solid #25402D;
        border-radius: 25px;
        padding: 40px 30px;
        text-align: center;
        color: white;
        box-shadow: 0 8px 18px rgba(0,0,0,0.15);
    }

    .confirm-text {
        font-size: 1.6rem;
        font-weight: 800;
        line-height: 1.3;
        margin-bottom: 35px;
    }

    .btn-container {
        display: flex;
        justify-content: center;
        gap: 15px;
    }

    .btn-pill-confirmar {
        background-color: #E6E4DC;
        color: #25402D;
        border: 2px solid #25402D;
        border-radius: 20px;
        padding: 8px 25px;
        font-weight: 800;
        font-size: 1.05rem;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
    }

    .btn-pill-confirmar:hover {
        background-color: #25402D;
        color: white;
    }

    .btn-pill-cancelar {
        background-color: #E6E4DC;
        color: #25402D;
        border: 2px solid #25402D;
        border-radius: 20px;
        padding: 8px 25px;
        font-weight: 800;
        font-size: 1.05rem;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-block;
    }

    .btn-pill-cancelar:hover {
        background-color: #25402D;
        color: white;
    }
</style>

<div class="header-banner">
    <h1>Eliminar Gerente</h1>
</div>

<div class="confirm-container">
    <div class="card-confirm">
        <div class="confirm-text">
            ¿Desea Eliminar<br />
            al gerente<br />
            seleccionado?
        </div>

        <form asp-controller="Gerentes" asp-action="Eliminar" method="post">
            <input type="hidden" asp-for="Id" />
            
            <div class="btn-container">
                <button type="submit" class="btn-pill-confirmar">Confirmar</button>
                <a asp-controller="Gerentes" asp-action="Index" class="btn-pill-cancelar">Cancelar</a>
            </div>
        </form>
    </div>
</div>