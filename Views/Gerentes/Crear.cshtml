@model Software_SARA.Dtos.GerenteDto

@{
    ViewData["Title"] = "Registrar Gerente - SARA";
}

<style>
    body {
        background-color: #E6E4DC;
    }

    .form-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px 10px;
    }

    .card-registrar {
        width: 100%;
        max-width: 520px;
        background-color: #385E42;
        border: 4px solid #25402D;
        border-radius: 35px;
        padding: 30px 35px;
        color: white;
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    }

    .title-registrar {
        font-size: 1.8rem;
        font-weight: 900;
        text-align: center;
        letter-spacing: 0.5px;
        margin-bottom: 2px;
        text-transform: uppercase;
    }

    .subtitle-registrar {
        font-size: 0.95rem;
        text-align: center;
        font-weight: 600;
        color: #E6E4DC;
        margin-bottom: 20px;
    }

    .form-label-custom {
        font-size: 0.85rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 4px;
        display: block;
    }

    .input-pill-sara {
        width: 100%;
        background-color: #ffffff;
        border: none;
        border-radius: 20px;
        padding: 8px 16px;
        font-size: 0.95rem;
        color: #333333;
        outline: none;
    }

    .input-pill-sara:focus {
        box-shadow: 0 0 0 3px rgba(230, 228, 220, 0.5);
    }

    .select-doc {
        border-radius: 20px 0 0 20px;
        width: 35%;
        border-right: 1px solid #ccc;
    }

    .input-doc {
        border-radius: 0 20px 20px 0;
        width: 65%;
    }

    .btn-pill-registrar {
        width: 100%;
        background-color: #ffffff;
        color: #25402D;
        border: 2px solid #25402D;
        border-radius: 25px;
        padding: 10px 0;
        font-weight: 900;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.2s ease;
        text-transform: uppercase;
    }

    .btn-pill-registrar:hover {
        background-color: #25402D;
        color: #ffffff;
    }

    .btn-pill-cancelar-form {
        width: 100%;
        background-color: transparent;
        color: #ffffff;
        border: 2px solid #ffffff;
        border-radius: 25px;
        padding: 10px 0;
        font-weight: 900;
        font-size: 1.1rem;
        text-decoration: none;
        display: inline-block;
        text-align: center;
        transition: all 0.2s ease;
        text-transform: uppercase;
    }

    .btn-pill-cancelar-form:hover {
        background-color: #ffffff;
        color: #25402D;
    }

    /* Recuadro superior simple */
    .error-resumen {
        background-color: #ffe6e6;
        color: #b30000;
        border: 1px solid #ffcccc;
        border-radius: 15px;
        padding: 10px 15px;
        font-weight: 700;
        font-size: 0.95rem;
        margin-bottom: 16px;
        text-align: center;
    }

    /* Letra de validación por campo en #ffcccc */
    .text-danger,
    .field-validation-error {
        color: #ffcccc !important;
        font-size: 0.88rem !important;
        font-weight: 800 !important;
        margin-top: 6px !important;
        display: block !important;
        padding-left: 10px;
    }

    .field-validation-valid {
        display: none !important;
    }
</style>

<div class="form-wrapper">
    <div class="card-registrar">

        <div class="title-registrar">Registrar Gerente</div>
        <div class="subtitle-registrar">Gestión de SARA</div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="error-resumen">
                Revisa los datos ingresados.
            </div>
        }

        <form asp-controller="Gerentes" asp-action="Crear" method="post">
            @Html.AntiForgeryToken()

            <!-- Sede Asignada -->
            <div class="mb-3">
                <label class="form-label-custom">Sede Asignada</label>
                <select asp-for="IdSede" class="input-pill-sara" asp-items="ViewBag.ListaSedes">
                    <option value="">-- Seleccione una Sede --</option>
                </select>
                <span asp-validation-for="IdSede" class="text-danger"></span>
            </div>

            <!-- Documento: Tipo y Número -->
            <div class="mb-3">
                <div class="d-flex justify-content-between">
                    <label class="form-label-custom" style="width: 35%;">Tipo Doc.</label>
                    <label class="form-label-custom" style="width: 63%;">Número de Documento (5 a 10 dígitos)</label>
                </div>
                <div class="d-flex">
                    <select asp-for="TipoDocumento" class="input-pill-sara select-doc">
                        <option value="CC">CC</option>
                        <option value="CE">CE</option>
                        <option value="PAS">PAS</option>
                    </select>
                    <input asp-for="NumeroDocumento"
                           id="inputDocumentoGerente"
                           type="text"
                           inputmode="numeric"
                           maxlength="10"
                           autocomplete="off"
                           class="input-pill-sara input-doc"
                           placeholder="Número de Documento" />
                </div>
                <span asp-validation-for="NumeroDocumento" class="text-danger"></span>
            </div>

            <!-- Nombres y Apellidos -->
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label-custom">Nombres</label>
                    <input asp-for="Nombres" class="input-pill-sara" placeholder="Nombres" />
                    <span asp-validation-for="Nombres" class="text-danger"></span>
                </div>
                <div class="col-6">
                    <label class="form-label-custom">Apellidos</label>
                    <input asp-for="Apellidos" class="input-pill-sara" placeholder="Apellidos" />
                    <span asp-validation-for="Apellidos" class="text-danger"></span>
                </div>
            </div>

            <!-- Teléfono y Correo -->
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label-custom">Teléfono (10 números)</label>
                    <input asp-for="Telefono"
                           id="inputTelefonoGerente"
                           type="text"
                           inputmode="numeric"
                           maxlength="10"
                           autocomplete="off"
                           class="input-pill-sara"
                           placeholder="Teléfono" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>
                <div class="col-6">
                    <label class="form-label-custom">Correo Electrónico</label>
                    <input asp-for="Correo" type="email" class="input-pill-sara" placeholder="Correo" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>
            </div>

            <!-- Dirección de Vivienda -->
            <div class="mb-3">
                <label class="form-label-custom">Dirección de Vivienda</label>
                <input asp-for="Direccion" class="input-pill-sara" placeholder="Dirección" />
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>

            <!-- Fecha de Nacimiento -->
            <div class="mb-4">
                <label class="form-label-custom">Fecha de Nacimiento</label>
                <input asp-for="FechaNacimiento" type="date" class="input-pill-sara" />
                <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
            </div>

            <!-- Botones -->
            <div class="d-flex flex-column gap-2">
                <button type="submit" class="btn-pill-registrar">REGISTRAR</button>
                <a asp-controller="Gerentes" asp-action="Index" class="btn-pill-cancelar-form">CANCELAR</a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            function restringirSoloNumeros(input, maxLen) {
                if (!input) return;

                input.addEventListener('beforeinput', function (e) {
                    if (e.data && /[^0-9]/.test(e.data)) {
                        e.preventDefault();
                    }
                });

                input.addEventListener('input', function () {
                    const limpio = this.value.replace(/[^0-9]/g, '').slice(0, maxLen);
                    if (this.value !== limpio) {
                        this.value = limpio;
                    }
                });
            }

            restringirSoloNumeros(document.getElementById('inputDocumentoGerente'), 10);
            restringirSoloNumeros(document.getElementById('inputTelefonoGerente'), 10);
        })();
    </script>
}