@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Acceso Denegado - SARA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body style="background-color: #31523E;" class="d-flex align-items-center justify-content-center vh-100 m-0">
    <div class="card p-5 text-center shadow-lg" style="max-width: 500px; background-color: #DAD7CD; border-radius: 35px; border: none;">
        <h1 class="display-1 text-danger fw-bold">🚫</h1>
        <h3 class="fw-bold mt-3" style="color: #1E3A2F;">¡Acceso Denegado!</h3>
        <p class="fs-5 text-muted mt-3">
            Tu rol actual no tiene los permisos necesarios para acceder a esta sección.<br>
            Si crees que esto es un error, contacta al Administrador del Sistema.
        </p>
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn text-white fw-bold py-2 px-4" style="background-color: #2E4E3B; border-radius: 20px;">Volver al Inicio</a>
            <a asp-controller="Acceso" asp-action="CerrarSesion" class="btn btn-outline-dark fw-bold py-2 px-4 ms-2" style="border-radius: 20px;">Cerrar Sesión</a>
        </div>
    </div>
</body>
</html>