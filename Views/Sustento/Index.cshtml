@{
    ViewData["Title"] = "Sustento de Caja";
}

<style>
    .sara-card-caja {
        background-color: #558257;
        border: 4px solid #2D4832;
        border-radius: 25px;
        width: 250px;
        height: 280px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: transform 0.2s;
        cursor: pointer;
    }

        .sara-card-caja:hover {
            transform: scale(1.05);
        }

    .sara-circle-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background-color: #D9D7C7;
        border: 3px solid #2D4832;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        color: #2D4832;
        font-weight: bold;
        margin-bottom: 20px;
    }
</style>

<div class="container py-4">
    <h3 class="fw-bold mb-4" style="color: #2D4832;">CALCULAR SUSTENTO MINIMO DE CAJA DIARIA</h3>

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger fw-bold shadow-sm">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["MensajeError"]
        </div>
    }

    <div class="d-flex justify-content-center mt-5">
        <!-- AHORA APUNTA A SeleccionarFecha -->
        <a asp-action="SeleccionarFecha" class="sara-card-caja shadow">
            <div class="sara-circle-icon"><i class="bi bi-calculator"></i></div>
            <h4 class="fw-bold text-white text-center">Calcular Sustento<br>Mínimo para<br>Caja Diaria</h4>
        </a>
    </div>
</div>