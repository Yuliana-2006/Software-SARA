@model Software_SARA.Dtos.SustentoDiarioDTO
@{
    ViewData["Title"] = "Sustento Calculado";
    var cultura = new System.Globalization.CultureInfo("es-CO");
}

<div class="container py-4">
    <h3 class="fw-bold mb-4" style="color: #2D4832;">Sustento Mínimo para Caja Diaria</h3>

    <div class="card shadow mx-auto" style="max-width: 800px; border: 3px solid #2D4832; border-radius: 15px; overflow: hidden;">
        <div class="card-body p-0">
            <table class="table table-bordered mb-0 text-center" style="background-color: #D9D7C7;">
                <thead style="background-color: #3B6146; color: white;">
                    <tr>
                        <th class="py-3">Id Factura</th>
                        <th class="py-3">Tipo Factura</th>
                        <th class="py-3">Fecha Vencimiento</th>
                        <th class="py-3">Valor</th>
                    </tr>
                </thead>
                <tbody style="border-color: #2D4832;">
                    @if (Model.Facturas != null && Model.Facturas.Any())
                    {
                        @foreach (var factura in Model.Facturas)
                        {
                            string tipo = factura.TipFactura ? "Proveedor" : "Servicio";
                            string nombreTipo = factura.TipFactura 
                                ? (factura.IdProveedorNavigation?.NomProveedor ?? "Proveedor") 
                                : (factura.IdServicioNavigation?.NomServicio ?? "Servicio");

                            <tr style="border-color: #2D4832;">
                                <td class="py-3 fw-bold">@factura.IdFactura</td>
                                <td class="py-3">@tipo (@nombreTipo)</td>
                                <td class="py-3">@factura.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td class="py-3 text-end pe-4">$ @factura.ValorFactura.ToString("N0", cultura)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="py-5 text-center text-muted fs-5">
                                No hay facturas pendientes de pago para el día de hoy (@DateTime.Today.ToString("dd/MM/yyyy")).
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot style="background-color: #D9D7C7; border-top: 3px solid #2D4832;">
                    <tr>
                        <td colspan="3" class="text-end fw-bold fs-5 py-3">Total:</td>
                        <td class="text-end fw-bold fs-5 py-3 pe-4" style="color: #2D4832;">
                            $ @Model.TotalSustento.ToString("N0", cultura)
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-action="Index" class="btn btn-outline-dark rounded-pill px-5 fw-bold" style="border: 2px solid #2D4832;">Volver</a>
    </div>
</div>