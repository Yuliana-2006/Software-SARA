@{
    ViewData["Title"] = "Gestión de Personal";
}

<style>
    .sara-main-card {
        background-color: #558257; border: 4px solid #2D4832;
        border-radius: 28px; color: #FFFFFF; width: 220px; height: 300px;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        text-decoration: none; transition: transform 0.2s;
    }
    .sara-main-card:hover { transform: translateY(-5px); color: white; }
    .sara-circle-icon {
        width: 90px; height: 90px; border-radius: 50%;
        background-color: #D9D7C7; border: 3.5px solid #2D4832;
        margin-bottom: 20px;
    }
</style>

<div class="container py-5">
    <h2 class="fw-bold text-center mb-5" style="color: #2D4832;">GESTIÓN DE PERSONAL</h2>

    <div class="d-flex flex-wrap justify-content-center align-items-center gap-5">
        <a asp-action="SeleccionarRol" asp-route-idRol="3" class="sara-main-card shadow">
            <div class="sara-circle-icon"></div>
            <h3 class="fw-bold fs-4">Tesorero</h3>
        </a>

        <a asp-action="SeleccionarRol" asp-route-idRol="4" class="sara-main-card shadow">
            <div class="sara-circle-icon"></div>
            <h3 class="fw-bold fs-4">Empleado</h3>
        </a>
    </div>
</div>