@model IEnumerable<Software_SARA.Repositories.Models.Usuario>
@{
    ViewData["Title"] = "Sección " + ViewBag.NombreRol;
    int idRol = ViewBag.IdRol;
}

<style>
    .sara-card { background-color: #558257; border: 4px solid #2D4832; border-radius: 25px; width: 250px; padding: 20px; color: white; text-align: center; }
    .sara-avatar { width: 90px; height: 90px; background-color: #D9D7C7; border-radius: 50%; margin: 0 auto 15px auto; border: 2px solid #2D4832; }
    .sara-btn { background-color: #D9D7C7; color: #2D4832; font-weight: 800; border: 3px solid #2D4832; border-radius: 50px; width: 100%; padding: 6px 0; margin-bottom: 10px; text-decoration: none; display: block; cursor: pointer;}
    .sara-btn:hover { background-color: #2D4832; color: white; }
    .sara-btn-danger { background-color: #A34848; color: white; }
    .sara-modal .modal-content { background-color: #558257; border: 4px solid #2D4832; border-radius: 25px; color: white; }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold" style="color: #2D4832;">SECCIÓN DE @ViewBag.NombreRol.ToUpper()</h3>
        <div>
            <!-- El botón de agregar apunta a Registrar con el idRol correcto -->
            <a asp-action="Registrar" asp-route-idRol="@idRol" class="btn btn-success rounded-pill fw-bold me-2">+ Agregar</a>
            <a asp-action="Index" class="btn btn-outline-dark rounded-pill fw-bold">Volver</a>
        </div>
    </div>

    @if (TempData["MensajeExito"] != null) { <div class="alert alert-success fw-bold">@TempData["MensajeExito"]</div> }
    @if (TempData["MensajeError"] != null) { <div class="alert alert-danger fw-bold">@TempData["MensajeError"]</div> }

    <div class="d-flex flex-wrap gap-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var p in Model)
            {
                <div class="sara-card shadow">
                    <div class="sara-avatar"></div>
                    <div class="fw-bold fs-5">@p.NomUsuario <br /> @p.ApelliUsuario</div>
                    <div class="small mb-3">@ViewBag.NombreSede</div>
                    
                    <div class="w-100">
                        <a asp-action="Consultar" asp-route-id="@p.IdUsuario" class="sara-btn">Consultar</a>
                        <a asp-action="Editar" asp-route-id="@p.IdUsuario" class="sara-btn">Editar</a>
                        <button type="button" class="sara-btn sara-btn-danger" onclick="confirmarEliminar(@p.IdUsuario, '@p.NomUsuario')">Eliminar</button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center w-100 py-5">
                <p class="fs-5 text-muted">No hay registros en la sección de @ViewBag.NombreRol.ToLower().</p>
            </div>
        }
    </div>
</div>

<!-- Modal Desactivar -->
<div class="modal fade sara-modal" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center p-4">
                <h4 class="fw-bold mb-3" id="textoEliminar"></h4>
                <form id="formEliminar" method="post" asp-action="Eliminar">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="idEliminar" />
                    <div class="d-flex justify-content-between mt-4">
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Confirmar</button>
                        <button type="button" class="btn btn-outline-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmarEliminar(id, nombre) {
            document.getElementById('idEliminar').value = id;
            document.getElementById('textoEliminar').innerHTML = `¿Seguro que quiere desactivar a<br><strong>${nombre}</strong>?`;
            new bootstrap.Modal(document.getElementById('modalEliminar')).show();
        }
    </script>
}