@model IEnumerable<Software_SARA.Models.Personal>

@{
    string rol = ViewBag.RolActual ?? "Empleado";
    ViewData["Title"] = "Sección " + rol + "s";
}

<style>
    .sara-card {
        background-color: #558257;
        border: 4px solid #2D4832;
        border-radius: 28px;
        color: #FFFFFF;
        width: 230px;
        min-height: 380px;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 20px 15px;
    }

    .sara-circle-avatar {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background-color: #D9D7C7;
        border: 3px solid #2D4832;
        margin-bottom: 12px;
    }

    .sara-btn-action {
        background-color: #D9D7C7;
        color: #2D4832;
        border: 3px solid #2D4832;
        border-radius: 50px;
        font-weight: 800;
        font-size: 1rem;
        width: 100%;
        text-align: center;
        padding: 4px 0;
        text-decoration: none;
        display: block;
        transition: background-color 0.2s ease;
    }

    .sara-btn-action:hover {
        background-color: #2D4832;
        color: #FFFFFF;
    }

    .sara-btn-danger {
        background-color: #A34848;
        color: #FFFFFF;
        border: 3px solid #2D4832;
    }

    .sara-btn-danger:hover {
        background-color: #722626;
        color: #FFFFFF;
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold" style="color: #2D4832;">SECCIÓN DE @rol.ToUpper()S</h3>
        <div>
            <a asp-action="SeleccionarRolRegistro" class="btn btn-success rounded-pill fw-bold me-2">+ Agregar</a>
            <a asp-action="Index" class="btn btn-outline-dark rounded-pill fw-bold">Volver</a>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-4 align-items-center justify-content-start">

        @if (Model != null && Model.Any())
        {
            @foreach (var p in Model)
            {
                <!-- Tarjeta individual del registro -->
                <div class="sara-card shadow">
                    <div class="sara-circle-avatar"></div>

                    <div class="text-center mb-3">
                        <div class="fw-bold fs-5 text-white">@p.Nombres <br /> @p.Apellidos</div>
                        <div class="fw-bold fs-6 text-white-50">@p.Rol</div>
                    </div>

                    <div class="w-100 d-flex flex-column gap-2 mt-auto">
                        <a asp-action="Consultar" asp-route-id="@p.Id" asp-route-rol="@p.Rol" class="sara-btn-action">Consultar</a>
                        <a asp-action="Editar" asp-route-id="@p.Id" asp-route-rol="@p.Rol" class="sara-btn-action">Editar</a>
                        
                        <form asp-action="Eliminar" method="post" onsubmit="return confirm('¿Deseas eliminar a @p.Nombres?');">
                            <input type="hidden" name="id" value="@p.Id" />
                            <input type="hidden" name="rol" value="@p.Rol" />
                            <button type="submit" class="sara-btn-action sara-btn-danger">Eliminar</button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center w-100 py-5">
                <p class="fs-5 text-muted">No hay registros en la sección de @rol.ToLower()s.</p>
            </div>
        }

    </div>
</div>