@{
    ViewData["Title"] = "Seleccionar Rol a Registrar";
}

<style>
    .sara-choice-card {
        background-color: #558257;
        border: 4px solid #2D4832;
        border-radius: 28px;
        color: #FFFFFF;
        width: 240px;
        height: 320px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .sara-choice-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.25);
        color: #FFFFFF;
    }

    .sara-circle-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background-color: #D9D7C7;
        border: 3.5px solid #2D4832;
        margin-bottom: 20px;
    }
</style>

<div class="container py-5 text-center">
    <h2 class="fw-bold mb-5" style="color: #2D4832;">¿A QUÉ ROL DESEAS REGISTRAR AL NUEVO PERSONAL?</h2>

    <div class="d-flex justify-content-center align-items-center gap-5 my-4">

        <!-- Opción Registrar Tesorero -->
        <a asp-controller="Personal" asp-action="Registrar" asp-route-rol="Tesorero" class="sara-choice-card shadow">
            <div class="sara-circle-avatar"></div>
            <h3 class="fw-bold fs-3">Tesorero</h3>
        </a>

        <!-- Opción Registrar Empleado -->
        <a asp-controller="Personal" asp-action="Registrar" asp-route-rol="Empleado" class="sara-choice-card shadow">
            <div class="sara-circle-avatar"></div>
            <h3 class="fw-bold fs-3">Empleado</h3>
        </a>

    </div>

    <div class="mt-4">
        <a asp-controller="Personal" asp-action="Index" class="btn btn-outline-dark rounded-pill fw-bold px-4">Volver al Inicio</a>
    </div>
</div>