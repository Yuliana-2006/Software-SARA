@model Software_SARA.Repositories.Models.Usuario
@{ ViewData["Title"] = "Consultar Personal"; }

<div class="container py-4">
    <div class="card shadow mx-auto p-4" style="max-width: 600px; background-color: #3B6146; color: white; border-radius: 30px;">
        <h3 class="fw-bold mb-4">Detalles del Personal</h3>
        
        <div class="mb-2 p-3" style="background-color: #558257; border-radius: 15px;">
            <small class="text-white-50 fw-bold">Nombres y Apellidos</small>
            <div class="fs-5 fw-bold">@Model.NomUsuario @Model.ApelliUsuario</div>
        </div>
        <div class="mb-2 p-3" style="background-color: #558257; border-radius: 15px;">
            <small class="text-white-50 fw-bold">Documento</small>
            <div class="fs-5 fw-bold">@(Model.TipDoc ? "CC" : "CE") @Model.NumDoc</div>
        </div>
        <div class="mb-2 p-3" style="background-color: #558257; border-radius: 15px;">
            <small class="text-white-50 fw-bold">Correo</small>
            <div class="fs-5 fw-bold">@Model.Correo</div>
        </div>
        <div class="mb-2 p-3" style="background-color: #558257; border-radius: 15px;">
            <small class="text-white-50 fw-bold">Teléfono</small>
            <div class="fs-5 fw-bold">@Model.Telefono</div>
        </div>
        <div class="mb-2 p-3" style="background-color: #558257; border-radius: 15px;">
            <small class="text-white-50 fw-bold">Dirección</small>
            <div class="fs-5 fw-bold">@Model.DirUsuario</div>
        </div>
        <div class="mb-4 p-3" style="background-color: #558257; border-radius: 15px;">
            <small class="text-white-50 fw-bold">Rol</small>
            <div class="fs-5 fw-bold">@(Model.IdRol == 3 ? "Tesorero" : "Empleado")</div>
        </div>

        <div class="text-center">
            <!-- AQUÍ ESTÁ LA CORRECCIÓN: asp-action="SeleccionarRol" -->
            <a asp-action="SeleccionarRol" asp-route-idRol="@Model.IdRol" class="btn btn-light rounded-pill px-5 fw-bold">Volver</a>
        </div>
    </div>
</div>