@model IEnumerable<Software_SARA.Repositories.Models.DiaCaja>
@{
    ViewData["Title"] = "Historial de Cajas";
    var cultura = new System.Globalization.CultureInfo("es-CO"); // Formato colombiano
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold" style="color: #2D4832;">HISTORIAL DE CAJAS - @ViewBag.NombreSede</h3>
        <a asp-action="Index" class="btn btn-outline-dark rounded-pill fw-bold"><i class="bi bi-arrow-left"></i> Volver a Caja</a>
    </div>

    <div class="card shadow" style="border-radius: 20px; overflow: hidden; border: 2px solid #2D4832;">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 text-center align-middle" style="background-color: white;">
                <thead style="background-color: #3B6146; color: white;">
                    <tr>
                        <th class="py-3">Resp. Apertura</th>
                        <th class="py-3">Fecha Apertura</th>
                        <th class="py-3">Monto Inicial</th>
                        <th class="py-3">Resp. Cierre</th>
                        <th class="py-3">Fecha Cierre</th>
                        <th class="py-3">Monto Final</th>
                        <th class="py-3">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">
                                    @(item.IdUsuarioNavigation != null ? item.IdUsuarioNavigation.NomUsuario : "Desconocido")
                                </td>
                                <td>@item.FechaHoraApertura.ToString("dd/MM/yyyy HH:mm")</td>
                                
                                <!-- Formato bonito para el Monto Inicial (SIN decimales, con puntos de miles) -->
                                <td class="text-success fw-bold">$ @item.MontoInicial.ToString("N0", cultura)</td>
                                
                                <td class="fw-bold text-dark">
                                    @if (item.IdUsuarioCierreNavigation != null)
                                    {
                                        @item.IdUsuarioCierreNavigation.NomUsuario
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>

                                <td>
                                    @if (!item.EstadoDia)
                                    {
                                        @item.FechaHoraCierre.ToString("dd/MM/yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-- Pendiente --</span>
                                    }
                                </td>
                                
                                <!-- Formato bonito para el Monto Final (SIN decimales, con puntos de miles) -->
                                <td class="text-primary fw-bold">
                                    @if (!item.EstadoDia)
                                    {
                                        @($"$ {item.MontoFinal.ToString("N0", cultura)}")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-- Pendiente --</span>
                                    }
                                </td>
                                <td>
                                    @if (item.EstadoDia)
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-2">ABIERTA</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill px-3 py-2">CERRADA</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-5 text-muted fs-5">No hay registros de caja en esta sede.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>