@{
    ViewData["Title"] = "Caja";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold" style="color: #2D4832;">GESTIÓN DE CAJA</h3>
    </div>

    @if (TempData["MensajeExito"] != null) { <div class="alert alert-success fw-bold shadow-sm">@TempData["MensajeExito"]</div> }
    @if (TempData["MensajeError"] != null) { <div class="alert alert-danger fw-bold shadow-sm">@TempData["MensajeError"]</div> }

    <div class="d-flex flex-wrap gap-4 mt-5 justify-content-center">
        
        <!-- Tarjeta Registrar Apertura -->
        <a asp-action="Apertura" class="text-decoration-none">
            <div class="card shadow d-flex justify-content-center align-items-center" style="width: 250px; height: 300px; background-color: #558257; border: 4px solid #2D4832; border-radius: 25px; transition: transform 0.2s;">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <div class="mb-3">
                        <span style="font-size: 4rem; color: #D9D7C7;">+</span>
                    </div>
                    <h4 class="fw-bold text-white">Registrar<br>Apertura</h4>
                </div>
            </div>
        </a>

        <!-- Tarjeta Registrar Cierre (Para el siguiente caso de uso) -->
        <a href="#" class="text-decoration-none">
            <div class="card shadow d-flex justify-content-center align-items-center" style="width: 250px; height: 300px; background-color: #558257; border: 4px solid #2D4832; border-radius: 25px; opacity: 0.7;">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <div class="mb-3">
                        <span style="font-size: 4rem; color: #D9D7C7;">-</span>
                    </div>
                    <h4 class="fw-bold text-white">Registrar<br>Cierre</h4>
                </div>
            </div>
        </a>
    </div>
</div>

<style>
    .card:hover { transform: scale(1.05); }
</style>