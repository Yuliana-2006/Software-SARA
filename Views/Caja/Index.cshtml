@model IEnumerable<Software_SARA.Repositories.Models.Usuario>
@{ ViewData["Title"] = "Gestión de Dueños"; }

<style>
    .sara-card-dueño { background-color: #558257; border: 3.5px solid #2D4832; border-radius: 25px; width: 260px; padding: 25px 20px; color: white; text-align: center; box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
    .sara-card-dueño.inactivo { background-color: #8a8a8a; border-color: #555555; }
    .sara-avatar { width: 100px; height: 100px; background-color: #D9D7C7; border-radius: 50%; margin: 0 auto 15px auto; border: 2px solid #2D4832; }
    .sara-name { font-size: 1.3rem; font-weight: 800; margin-bottom: 5px; line-height: 1.2; }
    .sara-role { font-size: 1rem; color: #C8E0C8; font-weight: 600; margin-bottom: 20px; }
    .sara-btn { background-color: #D9D7C7; color: #2D4832; font-weight: 800; border: 3px solid #2D4832; border-radius: 50px; width: 100%; padding: 6px 0; margin-bottom: 10px; text-decoration: none; display: block; transition: all 0.2s; font-size: 1rem; cursor: pointer;}
    .sara-btn:hover { background-color: #2D4832; color: #FFFFFF; }
    .sara-btn-danger { background-color: #A34848; color: #FFFFFF; }
    .sara-btn-danger:hover { background-color: #722626; color: #FFFFFF; }
    .sara-modal .modal-content { background-color: #558257; border: 4px solid #2D4832; border-radius: 25px; color: white; }
    .sara-modal .modal-body { padding: 40px 30px; }
    .sara-modal-title { font-weight: 900; font-size: 1.4rem; text-align: center; margin-bottom: 30px; line-height: 1.4; }
    .sara-modal-btn { background-color: #D9D7C7; color: #1A3020; font-weight: 800; border-radius: 50px; border: 3px solid #2D4832; padding: 8px 0; width: 45%; font-size: 1rem; }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold" style="color: #2D4832;">GESTIÓN DE DUEÑOS</h3>
        <a asp-action="Crear" class="btn btn-success rounded-pill fw-bold px-4">+ Registrar Nuevo Dueño</a>
    </div>

    @if (TempData["MensajeExito"] != null) { <div class="alert alert-success fw-bold shadow-sm">@TempData["MensajeExito"]</div> }
    @if (TempData["MensajeError"] != null) { <div class="alert alert-danger fw-bold shadow-sm">@TempData["MensajeError"]</div> }

    <div class="d-flex flex-wrap gap-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var d in Model)
            {
                <div class="sara-card-dueño @(d.EstadoUsuario ? "" : "inactivo")">
                    <div class="sara-avatar"></div>
                    <div class="sara-name">@d.NomUsuario <br /> @d.ApelliUsuario</div>
                    <div class="sara-role">Dueño</div>
                    
                    <div class="w-100 mt-auto">
                        <a asp-action="Consultar" asp-route-id="@d.IdUsuario" class="sara-btn">Consultar</a>
                        <a asp-action="Editar" asp-route-id="@d.IdUsuario" class="sara-btn">Editar</a>
                        
                        <button type="button" class="sara-btn @(d.EstadoUsuario ? "" : "text-success")" 
                                onclick="confirmarEstado(@d.IdUsuario, '@(d.EstadoUsuario ? "Inactivar" : "Activar")', '@d.NomUsuario')">
                            @(d.EstadoUsuario ? "Inactivar" : "Activar")
                        </button>

                        @if (!d.EstadoUsuario)
                        {
                            <button type="button" class="sara-btn sara-btn-danger" onclick="confirmarEliminar(@d.IdUsuario, '@d.NomUsuario')">
                                Eliminar
                            </button>
                        }
                    </div>
                </div>
            }
        }
        else { <p class="text-muted fs-5">No hay Dueños registrados.</p> }
    </div>
</div>

<!-- MODAL INACTIVAR -->
<div class="modal fade sara-modal" id="modalEstado" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center">
                <h4 class="sara-modal-title" id="textoEstado"></h4>
                <form id="formEstado" method="post" asp-action="CambiarEstado">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="idEstado" />
                    <div class="d-flex justify-content-between mt-4">
                        <button type="submit" class="sara-modal-btn">Confirmar</button>
                        <button type="button" class="sara-modal-btn" data-bs-dismiss="modal">Cancelar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- MODAL ELIMINAR -->
<div class="modal fade sara-modal" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center">
                <h4 class="sara-modal-title" id="textoEliminar"></h4>
                <form id="formEliminar" method="post" asp-action="Eliminar">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="idEliminar" />
                    <div class="d-flex justify-content-between mt-4">
                        <button type="submit" class="sara-modal-btn text-danger">Confirmar</button>
                        <button type="button" class="sara-modal-btn" data-bs-dismiss="modal">Cancelar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmarEstado(id, accion, nombre) {
            document.getElementById('idEstado').value = id;
            document.getElementById('textoEstado').innerHTML = `¿Desea <strong>${accion.toLowerCase()}</strong><br>al Dueño<br><strong>${nombre}</strong>?`;
            new bootstrap.Modal(document.getElementById('modalEstado')).show();
        }
        function confirmarEliminar(id, nombre) {
            document.getElementById('idEliminar').value = id;
            document.getElementById('textoEliminar').innerHTML = `¿Desea <strong>ELIMINAR</strong><br>a<br><strong>${nombre}</strong>?`;
            new bootstrap.Modal(document.getElementById('modalEliminar')).show();
        }
    </script>
}