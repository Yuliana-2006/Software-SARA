@using Microsoft.AspNetCore.Http
@{
    var rol = Context.Session.GetString("UsuarioRol") ?? "Usuario";
    var doc = Context.Session.GetString("UsuarioDoc") ?? "0000";

    // Inicial para el avatar circular
    var inicial = !string.IsNullOrEmpty(rol) ? rol.Substring(0, 1).ToUpper() : "U";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Software SARA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Iconos de Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            body {
                background-color: #ECE9DF;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            /* Sidebar lateral estilo SARA */
            .sidebar {
                width: 260px;
                background-color: #2E4F3E;
                min-height: 100vh;
                transition: all 0.3s;
            }

            .sidebar-header {
                background-color: #254030;
                padding: 15px;
                color: #ffffff;
                font-weight: bold;
                font-size: 18px;
            }

            .sidebar-menu a {
                color: #ffffff;
                text-decoration: none;
                padding: 12px 20px;
                display: flex;
                align-items: center;
                gap: 12px;
                font-weight: 600;
                font-size: 15px;
                transition: background 0.2s;
            }

                .sidebar-menu a:hover {
                    background-color: #3C6348;
                }

            /* Avatar de perfil superior */
            .avatar-circle {
                width: 40px;
                height: 40px;
                background-color: #3C6348;
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                font-size: 18px;
            }
    </style>
</head>
<body>

    <div class="d-flex">

        <!-- MENÚ LATERAL IZQUIERDO -->
        <div class="sidebar d-flex flex-column justify-content-between shadow" id="sidebarMenu">
            <div>
                <!-- Encabezado con 3 líneas y Nombre del Software sin recuadros -->
                <div class="sidebar-header d-flex align-items-center gap-2 border-0 bg-transparent px-3 py-3">
                    <i class="bi bi-list fs-3 text-white" style="cursor: pointer;"></i>
                    <span class="fw-bold text-white fs-5">Software SARA</span>
                </div>

                <!-- Lista de Acciones según el Rol -->
                <div class="sidebar-menu mt-2">
                    <a asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door-fill"></i> Inicio
                    </a>

                    @if (rol == "Dueño")
                    {
                        <a asp-controller="Sedes" asp-action="RegistrarSede"><i class="bi bi-building"></i> Sedes</a>
                        <a asp-controller="Home" asp-action="Index"><i class="bi bi-person-badge-fill"></i> Gerentes</a>
                        <a asp-controller="Home" asp-action="Index"><i class="bi bi-bar-chart-line-fill"></i> Informes</a>
                    }

                    @if (rol == "Gerente")
                    {
                        <a asp-controller="Home" asp-action="Index"><i class="bi bi-people-fill"></i> Personal</a>
                        <a asp-controller="Home" asp-action="Index"><i class="bi bi-cash-stack"></i> Caja</a>
                        <a asp-controller="Home" asp-action="Index"><i class="bi bi-receipt"></i> Facturas</a>
                        <a asp-controller="Home" asp-action="Index"><i class="bi bi-cart-check-fill"></i> Pedidos</a>
                        <a asp-controller="Home" asp-action="Index"><i class="bi bi-bell-fill"></i> Recordatorios</a>
                        <a asp-controller="Home" asp-action="Index"><i class="bi bi-bar-chart-line-fill"></i> Informes</a>
                    }

                    @if (rol == "Tesorero")
                    {
                        <a asp-controller="Home" asp-action="Index"><i class="bi bi-receipt"></i> Facturas</a>
                        <a asp-controller="Home" asp-action="Index"><i class="bi bi-box-arrow-in-right"></i> Apertura Caja</a>
                        <a asp-controller="Home" asp-action="Index"><i class="bi bi-box-arrow-left"></i> Cierre Caja</a>
                    }

                    @if (rol == "Empleado")
                    {
                        <a asp-controller="Home" asp-action="Index"><i class="bi bi-box-arrow-in-right"></i> Apertura Caja</a>
                        <a asp-controller="Home" asp-action="Index"><i class="bi bi-box-arrow-left"></i> Cierre Caja</a>
                    }
                </div>
            </div>

            <!-- Botón Cerrar Sesión al final -->
            <div class="sidebar-menu mb-3">
                <hr class="border-light opacity-25 mx-3" />
                <a asp-controller="Acceso" asp-action="CerrarSesion" class="text-warning">
                    <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                </a>
            </div>
        </div>

        <!-- CONTENIDO PRINCIPAL Y BARRA SUPERIOR -->
        <div class="flex-grow-1 d-flex flex-column min-vh-100">

            <!-- Barra Superior con Perfil de Usuario -->
            <div class="d-flex justify-content-end align-items-center px-4 py-3 bg-white shadow-sm" style="border-bottom: 2px solid #E2DFD2;">
                <div class="text-end me-3">
                    <div class="fw-bold text-dark" style="font-size: 15px;">@rol Demo</div>
                    <div class="text-uppercase fw-bold text-muted" style="font-size: 11px; letter-spacing: 0.5px;">@rol</div>
                </div>
                <div class="avatar-circle shadow-sm">
                    @inicial
                </div>
            </div>

            <!-- Área donde se renderizan las vistas -->
            <div class="p-4 flex-grow-1" style="background-color: #ECE9DF;">
                @RenderBody()
            </div>

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>