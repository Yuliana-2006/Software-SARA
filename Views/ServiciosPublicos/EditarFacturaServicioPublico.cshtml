@model Software_SARA.Dtos.FacServPublicDto

@{
    ViewData["Title"] = "Editar Factura de Servicio Público";
    var valorEntero = Model.ValorFactura > 0 ? ((long)Model.ValorFactura).ToString() : string.Empty;
}

<div class="registro-container">
    <div class="registro-card">

        <!-- TÍTULO -->
        <h1>EDITAR FACTURA DE SERVICIO PÚBLICO</h1>

        <form asp-controller="ServiciosPublicos"
              asp-action="EditarFacturaServicioPublico"
              method="post">

            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid || ViewData["Mensaje"] != null)
            {
                <div class="error-resumen">
                    <div class="error-resumen-titulo">Revisa los datos ingresados.</div>
                    @if (ViewData["Mensaje"] != null)
                    {
                        <div class="error-resumen-detalle">@ViewData["Mensaje"]</div>
                    }
                    <div class="error-resumen-detalle">
                        @Html.ValidationSummary(false, "", new { @class = "lista-errores-limpia" })
                    </div>
                </div>
            }

            <input type="hidden" asp-for="IdFactura" />

            <!-- FILA 1: Servicio y Valor Factura -->
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="IdServicio" class="control-label">Servicio</label>
                    <select asp-for="IdServicio" asp-items="ViewBag.Servicios" class="form-control">
                        <option value="">-- Seleccione un servicio --</option>
                    </select>
                    <span asp-validation-for="IdServicio" class="error-campo"></span>
                </div>

                <div class="form-group">
                    <label>Valor Factura (mayor a $10.000)</label>
                    <input asp-for="ValorFactura"
                           id="inputValorServicioEditar"
                           type="text"
                           inputmode="numeric"
                           autocomplete="off"
                           value="@valorEntero"
                           class="form-control"
                           placeholder="Ej: 25000" />
                    <span asp-validation-for="ValorFactura" class="error-campo"></span>
                </div>
            </div>

            <!-- FILA 2: Fecha de Registro y Fecha de Vencimiento -->
            <div class="form-row">
                <div class="form-group">
                    <label>Fecha de Registro</label>
                    <input asp-for="FechaRegFactura"
                           type="date"
                           class="form-control" />
                    <span asp-validation-for="FechaRegFactura" class="error-campo"></span>
                </div>

                <div class="form-group">
                    <label>Fecha de Vencimiento</label>
                    <input asp-for="FechaVencimiento"
                           type="date"
                           class="form-control"
                           min="@Model.FechaRegFactura.ToString("yyyy-MM-dd")"
                           value="@(Model.FechaVencimiento == default ? "" : Model.FechaVencimiento.ToString("yyyy-MM-dd"))" />
                    <span asp-validation-for="FechaVencimiento" class="error-campo"></span>
                </div>
            </div>

            <!-- BOTONES -->
            <div class="buttons" style="margin-top: 20px;">
                <button type="submit" class="btn-registrar">
                    GUARDAR CAMBIOS
                </button>

                <a asp-controller="ServiciosPublicos"
                   asp-action="FacturasServiciosPublicos"
                   class="btn-cancelar">
                    CANCELAR
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const inputValor = document.getElementById('inputValorServicioEditar');
            if (!inputValor) return;

            inputValor.addEventListener('beforeinput', function (e) {
                if (e.data && /[^0-9]/.test(e.data)) {
                    e.preventDefault();
                }
            });

            inputValor.addEventListener('input', function () {
                const limpio = this.value.replace(/[^0-9]/g, '');
                if (this.value !== limpio) {
                    this.value = limpio;
                }
            });
        })();
    </script>
}

<style>
    .registro-container {
        width: 100%;
        min-height: calc(100vh - 120px);
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding-top: 5px;
    }

    .registro-card {
        width: 100%;
        max-width: 610px;
        background-color: #3C694F;
        border: 2px solid #2E4F3E;
        border-radius: 30px;
        padding: 25px 28px 26px 28px;
        box-sizing: border-box;
        box-shadow: 0 5px 10px rgba(0, 0, 0, 0.15);
    }

    .registro-card h1 {
        color: white;
        text-align: center;
        font-size: 27px;
        font-weight: 800;
        margin: 0 0 22px 0;
    }

    .error-resumen {
        background-color: #ffe6e6;
        color: #b30000;
        border: 1px solid #ffcccc;
        padding: 12px 16px;
        border-radius: 12px;
        margin-bottom: 18px;
        width: 100%;
        box-sizing: border-box;
        font-size: 14px;
    }

    .error-resumen-titulo {
        font-weight: 800;
        font-size: 15px;
        margin-bottom: 4px;
    }

    .error-resumen-detalle {
        font-weight: 700;
        margin-top: 4px;
    }

    .lista-errores-limpia ul {
        list-style-type: none;
        padding: 0;
        margin: 0;
    }

    .lista-errores-limpia li {
        margin-top: 3px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 12px;
    }

    .form-group {
        margin-bottom: 12px;
    }

    .form-row .form-group {
        margin-bottom: 0;
    }

    .form-group label {
        display: block;
        color: white;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .form-control {
        width: 100%;
        height: 44px;
        border-radius: 25px;
        border: 1px solid #D0D0D0;
        background-color: #F8F9FA;
        padding: 8px 14px;
        font-size: 16px;
        box-sizing: border-box;
        outline: none;
    }

    .form-control:focus {
        border-color: #2E4F3E;
        box-shadow: 0 0 0 2px rgba(46, 79, 62, 0.25);
    }

    .form-control::placeholder {
        color: #777;
    }

    .error-campo,
    .text-danger,
    .field-validation-error {
        color: #ffcccc !important;
        font-weight: 700;
        font-size: 13px;
        margin-top: 5px;
        margin-left: 12px;
        display: block;
    }

    .field-validation-valid {
        display: none;
    }

    .buttons {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 9px;
        margin-top: 3px;
    }

    .btn-registrar,
    .btn-cancelar {
        width: 85%;
        height: 47px;
        border-radius: 25px;
        font-size: 16px;
        font-weight: 800;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
    }

    .btn-registrar {
        border: none;
        background-color: #F8F9FA;
        color: #29342E;
        cursor: pointer;
    }

    .btn-registrar:hover {
        background-color: #E5E7E8;
    }

    .btn-cancelar {
        background-color: transparent;
        border: 1.5px solid white;
        color: white;
        text-decoration: none;
    }

    .btn-cancelar:hover {
        background-color: rgba(255, 255, 255, 0.1);
        color: white;
    }

    @@media (max-width: 600px) {
        .registro-card {
            padding: 22px 18px;
        }
        .form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }
        .btn-registrar,
        .btn-cancelar {
            width: 100%;
        }
    }
</style>