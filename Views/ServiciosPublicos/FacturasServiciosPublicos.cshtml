@model IEnumerable<Software_SARA.Dtos.FacServPublicDto>

@{
    ViewData["Title"] = "Facturas Servicios Públicos";
}

<div class="facturas-container">
    <div class="facturas-header-banner">
        <h2>Facturas Servicios Públicos</h2>
        <a asp-controller="ServiciosPublicos" asp-action="VencimientoProximos" class="btn-vencimientos">
            Vencimientos próximos
        </a>
    </div>

    <div class="facturas-cards-wrapper">
        @foreach (var factura in Model)
        {
            string nombreServicio = "SERVICIO";
            string iconoClase = "bi-file-earmark-text";
            int idServ = factura.IdServicio ?? 0;

            switch (idServ)
            {
                case 1:
                    nombreServicio = "LUZ";
                    iconoClase = "bi-lightning-fill";
                    break;
                case 2:
                case 9:
                    nombreServicio = "AGUA";
                    iconoClase = "bi-droplet-fill";
                    break;
                case 3:
                case 11:
                    nombreServicio = "INTERNET";
                    iconoClase = "bi-wifi";
                    break;
                case 4:
                case 12:
                    nombreServicio = "ARRIENDO";
                    iconoClase = "bi-house-fill";
                    break;
                default:
                    nombreServicio = $"SERVICIO #{idServ}";
                    iconoClase = "bi-file-earmark-text";
                    break;
            }

            <div class="facturas-card">
                <div class="facturas-icon">
                    <i class="bi @iconoClase"></i>
                </div>

                <div class="facturas-name">
                    <h2>@nombreServicio</h2>
                    <div class="id-factura-card-text">Factura #@factura.IdFactura</div>
                </div>

                <div class="valor-factura-card-text">
                    Valor: $@factura.ValorFactura
                </div>

                <div class="facturas-buttons">
                    <button type="button" class="facturas-button"
                            onclick="mostrarFactura(
                        '@factura.IdFactura',
                        '@nombreServicio',
                        '$@factura.ValorFactura',
                        '@factura.FechaVencimiento.ToString("dd/MM/yyyy")',
                        '@(factura.EstadoFactura ? "Activa" : "Inactiva")'
                        )">
                        Consultar
                    </button>

                    <a asp-controller="ServiciosPublicos"
                       asp-action="EditarFacturaServicioPublico"
                       asp-route-id="@factura.IdFactura"
                       class="facturas-button">
                        Editar
                    </a>

                    <a asp-controller="ServiciosPublicos"
                       asp-action="ConfirmarPagoFacturaServicioPublico"
                       asp-route-id="@factura.IdFactura"
                       class="facturas-button">
                        Confirmar Pago
                    </a>
                </div>
            </div>
        }

        <a asp-controller="ServiciosPublicos" asp-action="CrearFacturaServicioPublico" class="facturas-link">
            <div class="facturas-card agregar-card">
                <div class="facturas-plus">
                    <i class="bi bi-plus-lg"></i>
                </div>
                <div class="facturas-title">
                    Registrar<br />
                    Factura
                </div>
            </div>
        </a>
    </div>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="mensaje-exito">
        @TempData["MensajeExito"]
    </div>
}

<div id="modalFactura" class="modal-facturaproveedor">
    <div class="consulta-card">
        <div class="consulta-header">
            <h2>Detalles de la Factura</h2>
            <button type="button" class="btn-cerrar-x" onclick="cerrarFactura()">&times;</button>
        </div>
        <div class="informacion-facturaproveedor">
            <div class="dato-facturaproveedor">
                <span>Factura Número</span>
                <strong id="datoIdFactura"></strong>
            </div>
            <div class="dato-facturaproveedor">
                <span>Servicio</span>
                <strong id="datoServicio"></strong>
            </div>
            <div class="dato-facturaproveedor">
                <span>Valor de la Factura</span>
                <strong id="datoValor"></strong>
            </div>
            <div class="dato-facturaproveedor">
                <span>Fecha de Vencimiento</span>
                <strong id="datoVencimiento"></strong>
            </div>
            <div class="dato-facturaproveedor">
                <span>Estado</span>
                <strong id="datoEstado"></strong>
            </div>
        </div>
        <button type="button" class="btn-cerrar-consulta" onclick="cerrarFactura()">Cerrar</button>
    </div>
</div>

<style>
    .facturas-container {
        width: 100%;
        min-height: calc(100vh - 120px);
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 10px;
        box-sizing: border-box;
    }

    .facturas-header-banner {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 40px;
        box-sizing: border-box;
        margin-bottom: 20px;
    }

        .facturas-header-banner h2 {
            margin: 0;
            color: #2E4F3E;
            font-size: 36px;
            font-weight: 800;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

    .btn-vencimientos {
        background-color: #385141;
        color: #ECE9DF;
        padding: 10px 22px;
        border-radius: 25px;
        font-size: 16px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        transition: background-color 0.2s ease;
    }

        .btn-vencimientos:hover {
            background-color: #2E4F3E;
            color: white;
            text-decoration: none;
        }

    .facturas-cards-wrapper {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 55px;
        flex-wrap: wrap;
        padding-top: 10px;
        box-sizing: border-box;
    }

    .facturas-card {
        width: 290px;
        height: 420px;
        flex: 0 0 290px;
        background-color: #5B805E;
        border: 7px solid #2E4F3E;
        border-radius: 35px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        overflow: hidden;
        box-shadow: 0 5px 10px rgba(0, 0, 0, 0.18);
    }

    .facturas-icon {
        width: 100px;
        height: 100px;
        min-width: 100px;
        min-height: 100px;
        margin-top: 20px;
        background-color: #ECE9DF;
        border: 6px solid #2E4F3E;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
    }

        .facturas-icon i {
            font-size: 44px;
            color: #2E4F3E;
            line-height: 1;
        }

    .facturas-name {
        width: 90%;
        margin-top: 8px;
        text-align: center;
    }

        .facturas-name h2 {
            margin: 0;
            font-size: 24px;
            color: #ECE9DF;
            font-weight: 800;
        }

    .id-factura-card-text {
        font-size: 18px;
        font-weight: 800;
        color: #ECE9DF;
        margin-top: 4px;
    }

    .valor-factura-card-text {
        color: #ECE9DF;
        font-size: 17px;
        font-weight: 800;
        text-align: center;
        margin-top: 4px;
    }

    .facturas-buttons {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        margin-top: 10px;
    }

    .facturas-button {
        width: 160px;
        height: 38px;
        padding: 0;
        border-radius: 25px;
        border: 6px solid #2E4F3E;
        background-color: #ECE9DF;
        color: #355B43;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 15px;
        font-weight: 800;
        line-height: 1;
        cursor: pointer;
        box-sizing: border-box;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .facturas-button:hover {
            background-color: #DCD9CF;
            color: #355B43;
            text-decoration: none;
        }

    .facturas-link {
        display: block;
        width: 290px;
        height: 420px;
        flex: 0 0 290px;
        text-decoration: none;
        color: inherit;
    }

    .agregar-card:hover {
        transform: translateY(-2px);
        transition: transform 0.2s ease;
    }

    .facturas-plus {
        width: 105px;
        height: 105px;
        min-width: 105px;
        min-height: 105px;
        margin-top: 65px;
        background-color: #ECE9DF;
        border: 6px solid #2E4F3E;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        color: #2E4F3E;
        font-size: 58px;
    }

    .facturas-title {
        width: 100%;
        margin-top: 35px;
        color: #F5F5F5;
        font-size: 32px;
        line-height: 1.05;
        font-weight: 800;
        text-align: center;
    }

    .mensaje-exito {
        position: fixed;
        right: 25px;
        bottom: 25px;
        background-color: #2E4F3E;
        color: white;
        padding: 18px 30px;
        border-radius: 18px;
        font-size: 20px;
        font-weight: 800;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.25);
        z-index: 9999;
    }

    .modal-facturaproveedor {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        display: none;
        justify-content: center;
        align-items: flex-start;
        overflow-y: auto;
        padding: 30px 20px;
        box-sizing: border-box;
        z-index: 1000;
    }

    .consulta-card {
        width: 100%;
        max-width: 600px;
        background-color: #2E543D;
        border-radius: 25px;
        padding: 25px 35px 35px 35px;
        box-sizing: border-box;
        position: relative;
    }

    .consulta-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

        .consulta-header h2 {
            margin: 0;
            color: white;
            font-size: 28px;
            font-weight: 800;
        }

    .btn-cerrar-x {
        width: 38px;
        height: 38px;
        border: none;
        background: transparent;
        color: #DCD9CF;
        font-size: 34px;
        line-height: 1;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .dato-facturaproveedor {
        background-color: #5E875E;
        border-radius: 15px;
        padding: 10px 16px;
        margin-bottom: 10px;
        color: white;
        box-sizing: border-box;
    }

        .dato-facturaproveedor span {
            display: block;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 3px;
        }

        .dato-facturaproveedor strong {
            display: block;
            font-size: 17px;
            font-weight: 800;
            color: white;
            word-break: break-word;
        }

    .btn-cerrar-consulta {
        display: block;
        width: 130px;
        height: 42px;
        margin: 18px auto 0 auto;
        border: none;
        border-radius: 25px;
        background-color: #ECE9DF;
        color: #2E4F3E;
        font-size: 16px;
        font-weight: 800;
        cursor: pointer;
        transition: 0.2s;
    }
</style>

<script>
    function mostrarFactura(id, proveedor, valor, vencimiento, estado) {
        document.getElementById("datoIdFactura").innerText = id;
        document.getElementById("datoServicio").innerText = proveedor;
        document.getElementById("datoValor").innerText = valor;
        document.getElementById("datoVencimiento").innerText = vencimiento;
        document.getElementById("datoEstado").innerText = estado;
        document.getElementById("modalFactura").style.display = "flex";
    }
    function cerrarFactura() {
        document.getElementById("modalFactura").style.display = "none";
    }
</script>