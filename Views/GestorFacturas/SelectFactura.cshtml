@{
    ViewData["Title"] = "Gestión de Facturas";
}

<style>
    .sara-main-card {
        background-color: #558257;
        border: 4px solid #2D4832;
        border-radius: 28px;
        color: #FFFFFF;
        width: 230px;
        height: 330px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .sara-main-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.25);
        color: #FFFFFF;
    }

    .sara-circle-icon {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background-color: #D9D7C7;
        border: 3.5px solid #2D4832;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .sara-plus-symbol {
        font-size: 65px;
        color: #2D4832;
        font-weight: bold;
        line-height: 0;
    }

    </style>


<div class="container py-5">
    <h2 class="fw-bold text-center mb-5" style="color: #2D4832;">GESTIÓN DE FACTURAS</h2>

    <div class="d-flex flex-wrap justify-content-center align-items-center gap-4">

        <!-- Tarjeta Facturas Proveedores -->
        <a asp-controller="Proveedores" asp-action="FacturasProveedores" class="sara-main-card shadow">
            <div class="sara-circle-icon"></div>
            <h3 class="fw-bold fs-4">Proveedores</h3>
        </a>

        <!-- Tarjeta Facturas Servicios -->
        <a asp-controller="ServiciosPublicos" asp-action="FacturasServiciosPublicos" class="sara-main-card shadow">
            <div class="sara-circle-icon"></div>
            <h3 class="fw-bold fs-4">Servicios Públicos</h3>
        </a>

    </div>
</div>