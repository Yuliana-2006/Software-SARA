@model Software_SARA.Dtos.FacProveedorDto
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Registrar Factura de Proveedor";
    var proveedores = ViewBag.Proveedores as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var hoyIso = DateOnly.FromDateTime(DateTime.Now).ToString("yyyy-MM-dd");
    var valorEntero = Model.ValorFactura > 0 ? ((long)Model.ValorFactura).ToString() : string.Empty;
    var erroresModelo = ViewData.ModelState?.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).Where(m => !string.IsNullOrWhiteSpace(m)).ToList() ?? new List<string>();
    var mensajeBanner = ViewData["Mensaje"] as string ?? ViewData["Message"] as string;
}

<div class="registro-factura-wrapper">
    <div class="registro-factura-card">
        <div class="registro-header">
            <h2>Registrar Factura de Proveedor</h2>
        </div>

        @if (!string.IsNullOrWhiteSpace(mensajeBanner) || erroresModelo.Any())
        {
            <div class="banner-error-general">
                @if (!string.IsNullOrWhiteSpace(mensajeBanner))
                {
                    <div>@mensajeBanner</div>
                }
                @foreach (var err in erroresModelo)
                {
                    <div>@err</div>
                }
            </div>
        }

        <form asp-controller="Proveedores" asp-action="CrearFacturaProveedor" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="IdProveedor">Proveedor</label>
                    <select asp-for="IdProveedor" asp-items="proveedores" class="form-control">
                        <option value="">-- Seleccione un proveedor --</option>
                    </select>
                    <span asp-validation-for="IdProveedor" class="error-campo"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ValorFactura">Valor de la Factura ($)</label>
                    <input asp-for="ValorFactura"
                           type="text"
                           inputmode="numeric"
                           value="@valorEntero"
                           placeholder="Ej: 50000"
                           class="form-control solo-enteros" />
                    <span asp-validation-for="ValorFactura" class="error-campo"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="FechaRegFactura">Fecha de Registro (Automática)</label>
                    <input asp-for="FechaRegFactura"
                           type="date"
                           value="@hoyIso"
                           min="@hoyIso"
                           max="@hoyIso"
                           readonly
                           class="form-control fecha-bloqueada" />
                    <span asp-validation-for="FechaRegFactura" class="error-campo"></span>
                </div>

                <div class="form-group">
                    <label asp-for="FechaVencimiento">Fecha de Vencimiento</label>
                    <input asp-for="FechaVencimiento"
                           type="date"
                           min="@hoyIso"
                           value="@(Model.FechaVencimiento == default ? hoyIso : Model.FechaVencimiento.ToString("yyyy-MM-dd"))"
                           class="form-control" />
                    <span asp-validation-for="FechaVencimiento" class="error-campo"></span>
                </div>
            </div>

            <div class="acciones-formulario">
                <a asp-controller="Proveedores" asp-action="FacturasProveedores" class="btn-secundario">
                    Volver
                </a>
                <button type="submit" class="btn-primario">
                    Guardar Factura
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .registro-factura-wrapper {
        width: 100%;
        min-height: calc(100vh - 120px);
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 30px 20px;
        box-sizing: border-box;
    }

    .registro-factura-card {
        width: 100%;
        max-width: 780px;
        background-color: #5B805E;
        border: 7px solid #2E4F3E;
        border-radius: 30px;
        padding: 30px 35px;
        box-sizing: border-box;
        box-shadow: 0 6px 14px rgba(0, 0, 0, 0.18);
    }

    .registro-header h2 {
        margin: 0 0 22px 0;
        color: #ECE9DF;
        font-size: 30px;
        font-weight: 800;
        text-align: center;
    }

    .banner-error-general {
        background-color: #ffe6e6;
        color: #b30000;
        border: 2px solid #b30000;
        border-radius: 14px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-weight: 700;
        font-size: 14px;
    }

    .form-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 18px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group label {
        color: #ECE9DF;
        font-weight: 800;
        font-size: 15px;
        margin-bottom: 6px;
    }

    .form-control {
        height: 44px;
        border-radius: 14px;
        border: 3px solid #2E4F3E;
        background-color: #ECE9DF;
        color: #2E4F3E;
        font-weight: 700;
        padding: 0 14px;
        box-sizing: border-box;
    }

    .fecha-bloqueada {
        background-color: #E9ECEF !important;
        color: #495057 !important;
        cursor: not-allowed;
    }

    .error-campo,
    .field-validation-error {
        display: block;
        margin-top: 6px;
        padding: 4px 10px;
        border-radius: 10px;
        background-color: #ffcccc;
        color: #b30000;
        font-size: 13px;
        font-weight: 700;
    }

    .field-validation-valid {
        display: none;
    }

    .acciones-formulario {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 26px;
        flex-wrap: wrap;
    }

    .btn-primario,
    .btn-secundario {
        padding: 11px 30px;
        border-radius: 25px;
        border: 5px solid #2E4F3E;
        font-size: 16px;
        font-weight: 800;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.15s ease, background-color 0.15s ease;
    }

    .btn-primario {
        background-color: #ECE9DF;
        color: #2E4F3E;
    }

    .btn-primario:hover {
        background-color: #ffffff;
        transform: scale(1.02);
    }

    .btn-secundario {
        background-color: #385141;
        color: #ECE9DF;
    }

    .btn-secundario:hover {
        background-color: #2E4F3E;
        color: #ffffff;
    }

    @@media (max-width: 680px) {
        .form-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    document.querySelectorAll(".solo-enteros").forEach(function (input) {
        input.addEventListener("beforeinput", function (e) {
            if (e.data && /[^0-9]/.test(e.data)) {
                e.preventDefault();
            }
        });
        input.addEventListener("input", function () {
            this.value = this.value.replace(/[^0-9]/g, "");
        });
    });
</script>