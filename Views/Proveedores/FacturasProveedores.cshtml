@model IEnumerable<Software_SARA.Dtos.FacProveedorDto>

@{
    ViewData["Title"] = "Facturas Proveedores";
}

<div class="facturas-container">

    <!-- Encabezado Principal de la Vista -->
    <div class="facturas-header-banner">
        <h2>Facturas Proveedores</h2>
        <a href="#" class="btn-vencimientos">
            Vencimientos próximos
        </a>
    </div>

    <!-- Contenedor de las Tarjetas -->
    <div class="facturas-cards-wrapper">

        <!-- Tarjeta 1: Proveedor (Con acciones Consultar, Editar, Confirmar Pago) -->
        <div class="facturas-card">

            <div class="facturas-icon">
                <i class="bi bi-truck"></i>
            </div>

            <div class="facturas-name">
                <h2>Proveedor</h2>
            </div>

            <div class="facturas-buttons">
                <button type="button" class="facturas-button" onclick="consultarProveedor()">
                    Consultar
                </button>

                <a href="#" class="facturas-button">
                    Editar
                </a>

                <a href="#" class="facturas-button">
                    Confirmar Pago
                </a>
            </div>

        </div>

        <!-- Tarjeta 2: Registrar Factura (Enlace para agregar) -->
        <a asp-controller="Proveedores" asp-action="CrearFacturaProveedor" class="facturas-link">
            <div class="facturas-card agregar-card">

                <div class="facturas-plus">
                    <i class="bi bi-plus-lg"></i>
                </div>

                <div class="facturas-title">
                    Registrar<br />
                    Factura
                </div>

            </div>
        </a>

    </div>

</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="mensaje-exito">
        @TempData["MensajeExito"]
    </div>
}

<style>

    /* =========================================
       CONTENEDOR GENERAL
       ========================================= */

    .facturas-container {
        width: 100%;
        min-height: calc(100vh - 120px);
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 10px;
        box-sizing: border-box;
    }

    /* =========================================
       ENCABEZADO Y BOTÓN VENCIMIENTOS
       ========================================= */

    .facturas-header-banner {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 40px;
        box-sizing: border-box;
        margin-bottom: 20px;
    }

    .facturas-header-banner h2 {
        margin: 0;
        color: #2E4F3E;
        font-size: 36px;
        font-weight: 800;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .btn-vencimientos {
        background-color: #385141;
        color: #ECE9DF;
        padding: 10px 22px;
        border-radius: 25px;
        font-size: 16px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        transition: background-color 0.2s ease;
    }

    .btn-vencimientos:hover {
        background-color: #2E4F3E;
        color: white;
        text-decoration: none;
    }

    /* =========================================
       WRAPPER DE TARJETAS
       ========================================= */

    .facturas-cards-wrapper {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 55px;
        flex-wrap: wrap;
        padding-top: 10px;
        box-sizing: border-box;
    }

    /* =========================================
       TARJETA GENERAL
       ========================================= */

    .facturas-card {
        width: 280px;
        height: 410px;
        flex: 0 0 280px;
        background-color: #5B805E;
        border: 7px solid #2E4F3E;
        border-radius: 35px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        overflow: hidden;
        box-shadow: 0 5px 10px rgba(0, 0, 0, 0.18);
    }

    /* =========================================
       ICONO CIRCULAR (CAMIÓN)
       ========================================= */

    .facturas-icon {
        width: 95px;
        height: 95px;
        min-width: 95px;
        min-height: 95px;
        margin-top: 20px;
        background-color: #ECE9DF;
        border: 6px solid #2E4F3E;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
    }

    .facturas-icon i {
        font-size: 44px;
        color: #2E4F3E;
        line-height: 1;
    }

    /* =========================================
       NOMBRE DE LA TARJETA
       ========================================= */

    .facturas-name {
        width: 90%;
        margin-top: 8px;
        color: #DAD7CD;
        font-size: 26px;
        line-height: 1.1;
        font-weight: 800;
        text-align: center;
    }

    .facturas-name h2 {
        margin: 0;
        font-size: 26px;
        color: #ECE9DF;
    }

    /* =========================================
       BOTONES INTERNOS DE LA TARJETA
       ========================================= */

    .facturas-buttons {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        margin-top: 12px;
    }

    .facturas-button {
        width: 150px;
        height: 38px;
        padding: 0;
        border-radius: 25px;
        border: 6px solid #2E4F3E;
        background-color: #ECE9DF;
        color: #355B43;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 16px;
        font-weight: 800;
        line-height: 1;
        cursor: pointer;
        box-sizing: border-box;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .facturas-button:hover {
        background-color: #DCD9CF;
        color: #355B43;
        text-decoration: none;
    }

    /* =========================================
       ENLACE DE AGREGAR (REGISTRAR FACTURA)
       ========================================= */

    .facturas-link {
        display: block;
        width: 280px;
        height: 410px;
        flex: 0 0 280px;
        text-decoration: none;
        color: inherit;
    }

    .facturas-link:hover {
        text-decoration: none;
        color: inherit;
    }

    .agregar-card:hover {
        transform: translateY(-2px);
        transition: transform 0.2s ease;
    }

    /* =========================================
       CÍRCULO DEL SIGNO +
       ========================================= */

    .facturas-plus {
        width: 105px;
        height: 105px;
        min-width: 105px;
        min-height: 105px;
        margin-top: 65px;
        background-color: #ECE9DF;
        border: 6px solid #2E4F3E;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        color: #2E4F3E;
        font-size: 58px;
    }

    /* =========================================
       TEXTO REGISTRAR FACTURA
       ========================================= */

    .facturas-title {
        width: 100%;
        margin-top: 35px;
        color: #F5F5F5;
        font-size: 32px;
        line-height: 1.05;
        font-weight: 800;
        text-align: center;
    }

    /* =========================================
       MENSAJE DE ÉXITO
       ========================================= */

    .mensaje-exito {
        position: fixed;
        right: 25px;
        bottom: 25px;
        background-color: #2E4F3E;
        color: white;
        padding: 18px 30px;
        border-radius: 18px;
        font-size: 20px;
        font-weight: 800;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.25);
        z-index: 9999;
        animation: mostrarMensaje 4s ease forwards;
    }

    @@keyframes mostrarMensaje {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }
        10% {
            opacity: 1;
            transform: translateY(0);
        }
        85% {
            opacity: 1;
            transform: translateY(0);
        }
        100% {
            opacity: 0;
            transform: translateY(20px);
            visibility: hidden;
        }
    }

    /* =========================================
       RESPONSIVE
       ========================================= */

    @@media (max-width: 750px) {
        .facturas-cards-wrapper {
            gap: 25px;
        }
        .facturas-header-banner {
            flex-direction: column;
            gap: 15px;
            align-items: flex-start;
            padding: 0 20px;
        }
    }

</style>