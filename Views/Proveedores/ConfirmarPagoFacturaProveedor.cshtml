@model Software_SARA.Dtos.FacProveedorDto

@{
    ViewData["Title"] = "Confirmar Pago de Factura de Proveedor";
}

<div class="confirmar-pago-page">
    @if (ViewData["Mensaje"] != null) 
    {
    <div style="color: white; background-color: #8B3A3A; padding: 10px; border-radius: 10px; margin-bottom: 15px;">
    @ViewData["Mensaje"]
    </div> 
    }

    <!-- ENCABEZADO -->
    <div class="confirmar-pago-header">
        <h1>CONFIRMAR PAGO DE FACTURA DE PROVEEDOR</h1>
    </div>


    <!-- TARJETA DE CONFIRMACIÓN -->
    <div class="confirmacion-container">

        <div class="confirmacion-card">

            <h2>
                ¿Desea confirmar el pago
                <br />
                de la factura
                <br />
                seleccionada?
            </h2>

            <div class="confirmacion-buttons">

                <!-- CONFIRMAR -->
                <form asp-controller="Proveedores"
                      asp-action="ConfirmarPagoFacturaProveedor"
                      method="post">

                    @Html.AntiForgeryToken()
                    <!-- Usamos asp-for para asegurar el ID correcto -->
                    <input type="hidden" asp-for="IdFactura" />

                    <button type="submit"
                            class="confirmacion-button">
                        Confirmar
                    </button>

                </form>


                <!-- CANCELAR -->
                <a asp-controller="Proveedores"
                   asp-action="FacturasProveedores"
                   class="confirmacion-button">
                    Cancelar
                </a>

            </div>

        </div>

    </div>

</div>


<style>

    /* =========================================
       PÁGINA
       ========================================= */

    .confirmar-pago-page {
        width: 100%;
        min-height: 100vh;
        background-color: #ECE9DF;
    }


    /* =========================================
       ENCABEZADO
       ========================================= */

    .confirmar-pago-header {
        width: 100%;
        height: 90px;

        background-color: #3C694F;

        display: flex;
        align-items: center;

        padding-left: 50px;

        box-sizing: border-box;
    }


    .confirmar-pago-header h1 {
        margin: 0;

        color: white;

        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;

        font-size: 42px;
        font-weight: 800;
    }


    /* =========================================
       CONTENEDOR
       ========================================= */

    .confirmacion-container {
        width: 100%;

        display: flex;

        justify-content: center;

        align-items: flex-start;

        padding-top: 88px;

        box-sizing: border-box;
    }


    /* =========================================
       TARJETA
       ========================================= */

    .confirmacion-card {
        width: 625px;
        min-height: 335px;

        background-color: #5E8562;

        border: 5px solid #2E4F3E;

        border-radius: 32px;

        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.20);

        display: flex;

        flex-direction: column;

        align-items: center;

        justify-content: center;

        padding: 45px 35px;

        box-sizing: border-box;
    }


    /* =========================================
       TEXTO
       ========================================= */

    .confirmacion-card h2 {
        margin: 0;

        color: white;

        text-align: center;

        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;

        font-size: 31px;

        line-height: 1.35;

        font-weight: 800;
    }


    /* =========================================
       BOTONES
       ========================================= */

    .confirmacion-buttons {
        display: flex;

        justify-content: center;

        align-items: center;

        gap: 20px;

        margin-top: 42px;
    }


    .confirmacion-buttons form {
        margin: 0;
    }


    .confirmacion-button {
        width: 170px;

        height: 56px;

        border-radius: 25px;

        border: 2px solid #2E4F3E;

        background-color: #ECE9DF;

        color: #293F32;

        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;

        font-size: 19px;

        font-weight: 800;

        text-decoration: none;

        display: flex;

        align-items: center;

        justify-content: center;

        box-sizing: border-box;

        cursor: pointer;
    }


    .confirmacion-button:hover {
        background-color: #DCD9CF;

        color: #293F32;
    }


    /* =========================================
       RESPONSIVE
       ========================================= */

    @@media (max-width: 700px) {

        .eliminar-header {
            padding-left: 25px;
        }

        .eliminar-header h1 {
            font-size: 32px;
        }

        .confirmacion-card {
            width: calc(100% - 30px);
        }

    }

</style>